# ── Supabase ──────────────────────────────────────────────
# Crée un projet sur https://supabase.com puis copie les clés ici.
NEXT_PUBLIC_SUPABASE_URL="https://xxxxxxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJ...anon..."
# Clé service_role (NE JAMAIS exposer côté client — utilisée par le webhook PayDunya)
SUPABASE_SERVICE_ROLE_KEY="eyJ...service_role..."

# ── PayDunya (paiement mobile money Sénégal : Wave, Orange Money, Free Money) ──
# Récupère ces clés sur https://paydunya.com (compte marchand)
PAYDUNYA_MASTER_KEY=""
PAYDUNYA_PRIVATE_KEY=""
PAYDUNYA_PUBLIC_KEY=""
PAYDUNYA_TOKEN=""
# "sandbox" pour les tests, "live" en production
PAYDUNYA_MODE="sandbox"

# ── App ───────────────────────────────────────────────────
# URL publique de l'app (utilisée pour les redirections PayDunya)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
